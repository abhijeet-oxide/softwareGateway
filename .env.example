# =============================================================================
# Software Gateway - single configuration file.
#
# YOU DO NOT NEED THIS FILE TO START. `docker compose up -d` on a fresh clone
# works with no .env at all: every variable below has a working default and
# the stack comes up seeded. Copy this to .env only when the system becomes
# reachable by someone other than you.
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose run --rm zitadel-init      # applies changes to users/products
#
# The zitadel-init container seeds the organization, the product projects,
# every role, the users and the first administrator, and prints a banner
# naming anything still on an insecure default.
# =============================================================================

# --- build behind a corporate proxy ------------------------------------------
# A build container inherits NOTHING from the host, so these must be passed
# explicitly or every fetch dies: `go mod download` with a TLS handshake
# timeout, and the web build with UND_ERR_CONNECT_TIMEOUT to registry.npmjs.org.
#
# THE PROXY ADDRESS MUST NOT BE localhost OR 127.0.0.1. Inside the container
# that means the container itself, and the build fails with
#   proxyconnect tcp: dial tcp 127.0.0.1:PORT: connect: connection refused
# Use the proxy's real hostname, or host.containers.internal (Podman) /
# host.docker.internal (Docker) if it genuinely runs on your machine.
#
# HTTP_PROXY=http://proxy.corp:8080
# HTTPS_PROXY=http://proxy.corp:8080
# NO_PROXY=localhost,127.0.0.1,.corp

# An internal module mirror or package registry avoids the proxy entirely:
# GOPROXY=https://artifactory.corp/api/go/go,direct
# GOSUMDB=off                      # only if the mirror does not proxy sum.golang.org
# NPM_REGISTRY=https://artifactory.corp/api/npm/npm/

# --- credentials for an AUTHENTICATED internal registry ----------------------
# Registry URLs above are not secret. Credentials are, so they are passed as
# mounted build SECRETS and never as build arguments: an ARG carrying a token
# is written into the image and stays readable in `docker history` forever.
#
#   cp deploy/npm/npmrc.example deploy/npm/npmrc      # npm / pnpm
#   cp deploy/go/netrc.example  deploy/go/netrc       # Go module proxy
#
# then point at them here. Both files are gitignored.
# NPM_CONFIG_FILE=./deploy/npm/npmrc
# GO_NETRC_FILE=./deploy/go/netrc

# --- images: pinned, and overridable for an internal registry ---------------
# Nothing is tagged `latest`: a tag that moves under you turns a working
# deployment into a support call nobody can reproduce. Versions below are the
# ones this stack was last verified against.
#
# Behind a pull-through cache configured in the daemon, change nothing. Behind
# an internal registry that re-hosts everything under its own path, set these:
#
#   POSTGRES_IMAGE=artifactory.corp/dockerhub/postgres:16.15-alpine
#   ZITADEL_IMAGE=artifactory.corp/ghcr/zitadel/zitadel:v4.17.3
#   ZITADEL_LOGIN_IMAGE=artifactory.corp/ghcr/zitadel/zitadel-login:v4.17.3
#   CERBOS_IMAGE=artifactory.corp/dockerhub/cerbos/cerbos:0.55.0
#   SEEDER_IMAGE=artifactory.corp/dockerhub/node:22.23.2-alpine
#
# ZITADEL is the one that names a registry by default, because it publishes to
# GHCR ONLY and is not on Docker Hub. If your proxy reaches only one upstream,
# ghcr.io is the one to mirror. Mirror BOTH ZITADEL images: since v3 the
# sign-in screens are a second container, and a stack without it has an
# identity provider that cannot show anyone a login form. Keep the two on the
# same version.
#
# POSTGRES_IMAGE=postgres:16.15-alpine
# ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.17.3
# ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.17.3
# CERBOS_IMAGE=cerbos/cerbos:0.55.0
# SEEDER_IMAGE=node:22.23.2-alpine
#
# Build-time bases for the images this repository builds itself:
# GO_IMAGE=golang:1.25.14
# NODE_IMAGE=node:22.23.2-alpine
# NGINX_IMAGE=nginx:1.27.5-alpine
# RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

# --- ports (host side) -------------------------------------------------------
WEB_PORT=8000               # the Software Gateway UI - this is the one you open
ZITADEL_PORT=8090           # ZITADEL: the sign-in screens AND the admin console
# ZITADEL_PORT is ONE address for the whole identity provider. The sign-in
# screens and the APIs are two containers behind a small proxy that publishes
# this port, because the core redirects to the sign-in screens by a relative
# path: split them across two ports and every login ends on a 404.
# The controller API is NOT published directly. It is reached through the web
# tier at http://localhost:${WEB_PORT}/api/v1, which keeps the browser
# same-origin and lets the controller scale past one replica.

# --- scale -------------------------------------------------------------------
CONTROLLER_REPLICAS=1       # control plane. Leader election picks one active.
WORKER_REPLICAS=2           # data plane. Stateless; raise this for throughput.
# Nothing else is needed to add workers. Each one authenticates as the same
# machine account in the identity provider, seeded once and mounted read-only,
# so there is no per-worker token to issue, distribute or rotate. See
# docs/design/24 section 5.1a.

# --- secrets: THE THREE THAT MATTER ------------------------------------------
# Unset, these fall back to values with INSECURE in the name, and the seeder
# says so on every run.
POSTGRES_PASSWORD=change-me-postgres
# EXACTLY 32 characters. ZITADEL refuses to start otherwise and reports it from
# inside a migration failure, so count. openssl rand -hex 16
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# --- first administrator -----------------------------------------------------
# Set EXACTLY ONE of the two blocks below.
#
# Local / demo: password login. Refused when SSO_ISSUER is set, so this
# shortcut cannot reach production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!Change
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#
# Production: passwordless. Set it empty (not commented out - commented out
# leaves it unset, which docker-compose.yml then fills with an insecure
# default) and the account is created with no password at all - nothing to
# leak or rotate.
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Microsoft SSO -----------------------------------------------------------
# Leave SSO_ISSUER empty for username/password login (local, demo, CI).
#
# In the Entra app registration, register ONE redirect URI:
#
#   http://localhost:${ZITADEL_PORT}/idps/callback
#
# under the WEB platform, not Single-page application. ZITADEL redeems the
# authorization code from its own backend using the client secret, which is a
# confidential client; Entra requires PKCE for anything registered as an SPA
# and the sign-in then fails with AADSTS9002325 AFTER the password has been
# typed. Entra also requires https for any redirect URI that is not localhost.
# The seeder prints the exact URI on every run. See deploy/STACK.md.
# Fill all three and login redirects straight to Microsoft; ZITADEL's own
# form is never shown.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DISPLAY_NAME=Microsoft
SSO_AUTO_REDIRECT=true

# --- what exists -------------------------------------------------------------
# One ZITADEL project is created per product. Add one here, re-run
# zitadel-init, and it appears with its full role set.
GATEWAY_TENANT=default
GATEWAY_PRODUCTS=software-01,software-02,software-03

# Role vocabulary. The org- tier names no product, so it covers products
# created later. The product- tier applies to one product only, and its keys
# are stored namespaced as "<product>:<role>" so a token says which product it
# means without any lookup.
GATEWAY_ORG_ROLES=org-admin,org-operator,org-security,org-reader
GATEWAY_PRODUCT_ROLES=product-owner,product-operator,product-reader

# --- people ------------------------------------------------------------------
# Users and their role mappings live in deploy/zitadel/users.json. Add a person
# there, commit, and re-run:  docker compose run --rm zitadel-init
# That file is the provisioning mechanism, so who has access is reviewable in a
# pull request rather than being clicks in a console.

# --- enforcement -------------------------------------------------------------
# false makes every caller anonymous. Local debugging only; never in anything
# reachable from outside your machine.
AUTH_ENABLED=true

# Who the data plane's credentials are written for. The seeder runs as root and
# the worker image is distroless nonroot, so the file it writes is handed over
# to the uid the worker runs as. 65532 is nonroot in gcr.io/distroless/*; change
# it only alongside RUNTIME_IMAGE.
# WORKER_UID=65532
# Set to any value to reissue the worker credentials on the next seeder run.
# Running workers move over on their own within a few seconds - they read the
# file when they need a token, not once at boot - so no restart is needed.
# WORKER_ROTATE_SECRET=1
