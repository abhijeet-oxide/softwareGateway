# =============================================================================
# Software Gateway - configuration for `task run` and `docker compose`.
#
# A cluster does not read this file. It reads one values file per deployment:
# deploy/flux/instances/<instance>/values/values.yaml.
#
# NOTHING BELOW IS REQUIRED TO START. `docker compose up -d` on a fresh clone
# comes up seeded with no .env at all. Copy this file when the stack becomes
# reachable by somebody other than you:
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose run --rm zitadel-init    # applies changes to users/products
#
# Every variable is marked. REQUIRED means: set it before anybody but you can
# reach this. OPTIONAL means: it has a working default, and the line says the
# one reason to change it.
# =============================================================================


# ============================== REQUIRED =====================================
# Three values. Unset, they fall back to defaults with INSECURE in the name and
# the seeder says so on every run.

# REQUIRED. The database password.
POSTGRES_PASSWORD=change-me-postgres

# REQUIRED. EXACTLY 32 characters - ZITADEL refuses to start otherwise and
# reports it from inside a migration failure, so the symptom names neither this
# setting nor its length.  openssl rand -hex 16
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# REQUIRED. The first administrator, created before anybody has signed in.
# Set the password for local and demo use; set it EMPTY (not commented out) for
# a passwordless account with nothing to leak. The seeder refuses to run with a
# password set while SSO_ISSUER is configured, so the shortcut cannot follow you
# into production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Passw0rd!Change
# OPTIONAL. The administrator's real name, when it is known here. Unset, the
# seeder works one out of the address if the address spells one, and otherwise
# uses the username - a name it invented is a name that person reads on their
# own profile. The directory's own name replaces it at first sign-in.
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=

# REQUIRED. ZITADEL's own root account, created at first boot. Separate from the
# administrator above: this one owns the instance, that one owns the product.
ZITADEL_ROOT_PASSWORD=change-me-root


# ============================== OPTIONAL =====================================

# --- who this deployment serves ----------------------------------------------
# OPTIONAL, and it is a SECURITY BOUNDARY rather than a label: the ZITADEL
# organization this deployment serves, passed to the coordinator as
# SWGW_AUTH_TENANT. A token from any other organization at the same issuer is
# refused whatever roles it carries.
GATEWAY_TENANT=default

# OPTIONAL. Who somebody is told to ask when this deployment refuses them - a
# mailbox, a service desk, a page. Unset names no route rather than inventing
# one.
# SUPPORT_CONTACT=platform-team@example.com

# --- ports (host side) -------------------------------------------------------
# OPTIONAL. WEB_PORT is the one you open. ZITADEL_PORT is ONE address for the
# whole identity provider: the sign-in screens and the APIs are two containers
# behind a small proxy, because the core redirects to the screens by a relative
# path - split them across two ports and every login ends on a 404.
#
# The controller API is not published directly. The browser reaches it through
# the web tier at http://localhost:${WEB_PORT}/api/v1, which keeps it
# same-origin.
WEB_PORT=8000
ZITADEL_PORT=8090
# OPTIONAL. The host a BROWSER reaches ZITADEL at. `localhost` is right for a
# laptop; set it when the stack is reached by a name other than that, because
# ZITADEL stamps it into every token's `iss` and answers 404 to a Host header it
# does not recognise.
# ZITADEL_EXTERNAL_DOMAIN=localhost

# --- scale -------------------------------------------------------------------
# OPTIONAL. Workers are stateless and all share one machine account, so raising
# this needs nothing else - no per-worker token to issue or rotate.
CONTROLLER_REPLICAS=1
WORKER_REPLICAS=2

# --- single sign-on ----------------------------------------------------------
# OPTIONAL. Empty means username and password, which is local, demo and CI.
#
# Register ONE redirect URI in the directory:
#
#   http://localhost:${ZITADEL_PORT}/idps/callback
#
# under the WEB platform, NOT Single-page application. ZITADEL redeems the code
# from its own backend with the client secret - a confidential client - and a
# directory that requires PKCE for an SPA fails the sign-in AFTER the password
# has been typed. The seeder prints the exact URI on every run.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# OPTIONAL. What the directory is CALLED: one string for the sign-in button, the
# refusal page, and the source of somebody's details on their profile.
SSO_DISPLAY_NAME=Microsoft
# OPTIONAL. Keeps ZITADEL's own password box after single sign-on is configured,
# which is the way back in while the directory path is still being proven.
# SSO_ALLOW_PASSWORD_LOGIN=false
# OPTIONAL. Require a second factor at ZITADEL, on top of whatever the directory
# already asked for.
# LOGIN_REQUIRE_MFA=false
# OPTIONAL. Which field an external sign-in is matched against. `email` is the
# one string both systems usually hold; set `username` where the directory
# asserts a user principal name and no mail attribute.
# SSO_LINK_ON=email

# --- how long a removal takes to bite ----------------------------------------
# OPTIONAL. The coordinator verifies tokens offline and never asks whether one
# is still good, so a token already issued works until it EXPIRES. What a
# removal stops at once is the RENEWAL - this is that window. ZITADEL's own
# default is 12h; it is 15m here.
# ACCESS_TOKEN_LIFETIME=15m
# ID_TOKEN_LIFETIME=12h
# REFRESH_TOKEN_IDLE=720h
# REFRESH_TOKEN_MAX=2160h

# --- what the sign-in screens look like --------------------------------------
# OPTIONAL. Applied to ZITADEL's own screens by the seeder. Unset leaves
# ZITADEL's defaults; the logos default to deploy/zitadel/branding.
# BRANDING_PRIMARY_COLOR=
# BRANDING_PRIMARY_COLOR_DARK=
# BRANDING_LANGUAGES=en
# BRANDING_DIR=./deploy/zitadel/branding
# BRANDING_LOGO_FILE=
# BRANDING_LOGO_DARK_FILE=

# --- enforcement -------------------------------------------------------------
# OPTIONAL. false makes every caller anonymous. Local debugging only.
AUTH_ENABLED=true

# --- images ------------------------------------------------------------------
# OPTIONAL. Nothing is tagged `latest`. Behind a pull-through cache configured
# in the daemon, change nothing; behind a registry that re-hosts everything under
# its own path, set all five.
#
# ZITADEL publishes to GHCR ONLY. If your mirror reaches one upstream, that is
# the one - and mirror BOTH ZITADEL images on the same version, because since v3
# the sign-in screens are a second container and a stack without it has an
# identity provider that cannot show anyone a login form.
# POSTGRES_IMAGE=postgres:16.15-alpine
# ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.17.3
# ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.17.3
# CERBOS_IMAGE=cerbos/cerbos:0.55.0
# SEEDER_IMAGE=node:22.23.2-alpine
#
# OPTIONAL. The three images this repository builds. Set them to run a published
# tag instead of the locally built one.
# CONTROLLER_IMAGE=software-gateway-controller:local
# WORKER_IMAGE=software-gateway-worker:local
# WEB_IMAGE=software-gateway-web:local
#
# OPTIONAL. Build-time bases for those three.
# GO_IMAGE=golang:1.26.5
# NODE_IMAGE=node:22.23.2-alpine
# NGINX_IMAGE=nginx:1.27.5-alpine
# RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

# --- building behind a corporate proxy ---------------------------------------
# OPTIONAL. A build container inherits NOTHING from the host, so these must be
# passed explicitly or every fetch dies.
#
# THE ADDRESS MUST NOT BE localhost OR 127.0.0.1 - inside the container that is
# the container itself. Use the proxy's real hostname, or
# host.containers.internal (Podman) / host.docker.internal (Docker).
# HTTP_PROXY=http://proxy.corp:8080
# HTTPS_PROXY=http://proxy.corp:8080
# NO_PROXY=localhost,127.0.0.1,.corp
#
# An internal mirror avoids the proxy entirely:
# GOPROXY=https://artifactory.corp/api/go/go,direct
# GOSUMDB=off                      # only if the mirror does not proxy sum.golang.org
# NPM_REGISTRY=https://artifactory.corp/api/npm/npm/
#
# Credentials for an authenticated mirror are mounted build SECRETS, never build
# arguments: an ARG carrying a token stays readable in `docker history` forever.
#
#   cp deploy/npm/npmrc.example deploy/npm/npmrc
#   cp deploy/go/netrc.example  deploy/go/netrc
#
# NPM_CONFIG_FILE=./deploy/npm/npmrc
# GO_NETRC_FILE=./deploy/go/netrc

# --- the data plane's credentials --------------------------------------------
# OPTIONAL. Who the worker credentials are written for: the seeder runs as root
# and the worker image is distroless nonroot. 65532 is nonroot in
# gcr.io/distroless/*; change it only alongside RUNTIME_IMAGE.
# OPTIONAL. What a worker calls itself in the fleet list. Under compose the
# container id becomes the suffix; in a cluster the pod name is used instead.
# WORKER_NAME=worker
# WORKER_UID=65532
# Set to any value to reissue the worker credentials on the next seeder run.
# Running workers move over within a few seconds; no restart is needed.
# WORKER_ROTATE_SECRET=1

# --- where the configuration directory is ------------------------------------
# OPTIONAL. The products, the people, the roles and the policies are content an
# administrator manages, not settings a deployment is tuned with, so they are
# files in config/ rather than variables here. See config/README.md.
# Set this only to point at a checkout kept apart from the code.
# CONFIG_DIR=./config
