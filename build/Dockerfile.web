# syntax=docker/dockerfile:1
#
# Web image: the built SPA behind nginx, which also proxies /api to the
# controller so the browser stays same-origin. See deploy/web/nginx.conf.

FROM node:22-alpine AS build
WORKDIR /src

# Manifests first so a source-only change does not re-install node_modules.
COPY web/package.json web/package-lock.json* web/pnpm-lock.yaml* web/pnpm-workspace.yaml* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/web/nginx.conf /etc/nginx/conf.d/app.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
