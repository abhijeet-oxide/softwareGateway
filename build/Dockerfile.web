# syntax=docker/dockerfile:1
#
# Web image: the built SPA behind nginx, which also proxies /api to the
# controller so the browser stays same-origin. See deploy/web/nginx.conf.

# Pinned, and overridable for an internal registry or pull-through proxy.
# Base images: declared here, above every FROM, because an ARG used in a
# FROM must be in the global scope - one declared inside a stage is
# invisible to the next FROM and fails with "base name should not be blank".
# All are overridable for an internal registry or pull-through proxy.
ARG NODE_IMAGE=node:22.23.2-alpine
ARG NGINX_IMAGE=nginx:1.27.5-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /src

# Network configuration for a build behind a corporate proxy.
#
# A container gets NONE of the host's proxy settings, so without these every
# fetch dies the same way: `ConnectTimeoutError` to registry.npmjs.org, or a
# TLS handshake timeout. Empty by default, which is the direct-internet case.
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY}

# Trust any CA the operator supplied. A TLS-intercepting corporate proxy makes
# `npm ci` fail with SELF_SIGNED_CERT_IN_CHAIN, and the only correct fix is to
# trust the proxy's CA - never to disable verification. The directory is
# copied unconditionally because Docker cannot COPY a file that may not exist;
# it is empty by default and the RUN below then does nothing.
COPY deploy/certs/ /usr/local/share/ca-certificates/extra/
# The bundle is written UNCONDITIONALLY - system CAs alone when no extra certs
# were supplied. NODE_EXTRA_CA_CERTS below is a fixed path, so a bundle that
# exists only sometimes produces "Ignoring extra certs ... No such file or
# directory" on every build that did not supply one.
RUN mkdir -p /usr/local/share/ca-certificates/extra && \
    if ls /usr/local/share/ca-certificates/extra/*.crt >/dev/null 2>&1; then \
      cat /usr/local/share/ca-certificates/extra/*.crt /etc/ssl/certs/ca-certificates.crt \
        > /usr/local/share/ca-certificates/bundle.pem; \
      echo "trusting operator-supplied CA certificates"; \
    else \
      cp /etc/ssl/certs/ca-certificates.crt /usr/local/share/ca-certificates/bundle.pem; \
    fi
# Config comes from the ENVIRONMENT, not from `npm config set`.
#
# Two reasons, and the second is not obvious. `npm config set` WRITES to
# /root/.npmrc, which the credentials secret is mounted over during install -
# so the value would be silently shadowed exactly when it matters. And once
# that path is a read-only mount, the write itself fails with a rofs error.
# npm and pnpm both read NPM_CONFIG_*, which needs no writable file at all.
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/bundle.pem \
    NPM_CONFIG_CAFILE=/usr/local/share/ca-certificates/bundle.pem

# Manifests first so a source-only change does not re-install node_modules.
COPY web/package.json web/pnpm-lock.yaml* web/pnpm-workspace.yaml* web/package-lock.json* ./

# pnpm is this repository's package manager, and the order matters: a stale
# web/package-lock.json is also committed (older, and missing
# @iconify-json/boxicons), so an npm-first build fails with EUSAGE on a tree
# that is perfectly healthy. pnpm-lock.yaml is the one kept in step.
# pnpm is installed with npm, NOT corepack. corepack resolves "pnpm/latest"
# against registry.npmjs.org directly and honours neither `npm config set
# registry` nor the proxy variables, so behind a proxy it fails with
# UND_ERR_CONNECT_TIMEOUT before any dependency is even fetched. npm honours
# both, so one configured registry serves the package manager and the packages.
ARG PNPM_VERSION=12.3.4

# Credentials for an authenticated registry arrive as a MOUNTED SECRET, never
# as a build argument.
#
# An ARG carrying a token is written into the image's build history and is
# readable by anyone who can pull the image - `docker history` prints it. A
# secret mount exists only for the lifetime of this one RUN and touches no
# layer. It is also the only mechanism that covers every auth style a registry
# might document (_authToken, _auth, scoped registries) without this file
# having to know which one you use.
#
# The mount is optional: with no credentials configured the default empty
# npmrc is mounted and NPM_REGISTRY alone decides where packages come from.
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm install -g "pnpm@$PNPM_VERSION" && \
    if [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY web/ ./
RUN if [ -f pnpm-lock.yaml ]; then pnpm run build; else npm run build; fi

FROM ${NGINX_IMAGE} AS runtime
RUN rm /etc/nginx/conf.d/default.conf
COPY deploy/web/nginx.conf /etc/nginx/conf.d/app.conf
COPY deploy/web/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

# Three questions, because the obvious one-liner answers none of them.
#
# `wget http://127.0.0.1/` was the healthcheck, and it passes on a container
# whose upstream is gone and whose runtime configuration was never written:
# every unknown path falls through to index.html, so the router fallback
# answers 200 for anything at all. What this tier is FOR is serving the
# application and putting it in touch with the Coordinator, so it is healthy
# when all three of those are true:
#
#   /healthz             nginx is serving (matched exactly, no fallback)
#   /runtime-config.json docker-entrypoint.sh ran and published the sign-in
#                        configuration the SPA reads before it can authenticate
#   /readyz              the Coordinator answers its own liveness endpoint
#                        through this tier's proxy
#
# Retries rather than a long timeout: a Coordinator restart should not flap
# this container's health, and five attempts at ten seconds tolerates one.
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 \
   && wget -qO- http://127.0.0.1/runtime-config.json >/dev/null 2>&1 \
   && wget -qO- http://127.0.0.1/readyz >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/docker-entrypoint.sh"]
