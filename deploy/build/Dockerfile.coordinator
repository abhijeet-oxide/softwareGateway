# syntax=docker/dockerfile:1
#
# Coordinator image. See docs/design/14-deployment-and-development.md section 6.
#
# golang:1.25 rather than 1.24: prometheus/client_golang and the OTel stack
# require Go 1.25, which raised the module's floor. Recorded in docs/design/16.

# Pinned, and overridable so an internal registry or pull-through proxy can be
# used: docker compose build --build-arg GO_IMAGE=registry.corp/golang:1.25.14
# Base images: declared here, above every FROM, because an ARG used in a
# FROM must be in the global scope - one declared inside a stage is
# invisible to the next FROM and fails with "base name should not be blank".
# All are overridable for an internal registry or pull-through proxy.
ARG GO_IMAGE=golang:1.25.14
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

# Helm, fetched in its own stage and copied into the runtime image.
#
# The Coordinator renders charts by running `helm template` as a subprocess -
# see internal/compliance/render/helm.go for why it is a subprocess and not the
# Helm Go SDK. Without the binary on PATH every check that needs a rendered
# manifest reports `error` and the run is inconclusive, which is correct
# behaviour and useless in a deployment.
#
# 3.21.3 rather than the newest minor: helm's template engine is what turns a
# chart into the objects a compliance finding is written against, so the
# most-patched line is worth more here than the newest one. Overridable, and
# the checksum must be overridden with it.
ARG HELM_VERSION=3.21.3
ARG HELM_SHA256_amd64=15e041a93a590dce8100f39385cd98c84a765c9e36aeeb9e2dc6ff9e4769e2e0
ARG HELM_SHA256_arm64=67f58155079ff9ffab98ba5c88daff0ed9b542f3a4732f5dd426dde7dd0f5244

FROM ${GO_IMAGE} AS build
WORKDIR /src

# Network configuration for a build behind a corporate proxy. A container
# inherits none of the host's proxy settings, so without these `go mod
# download` fails with a TLS handshake timeout against storage.googleapis.com.
# GOPROXY additionally lets an internal module mirror serve the whole graph.
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY} \
    GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}

# See deploy/build/Dockerfile.web for why this exists. Same problem, different tool:
# `go mod download` fails with x509: certificate signed by unknown authority.
COPY deploy/certs/ /usr/local/share/ca-certificates/extra/
RUN if ls /usr/local/share/ca-certificates/extra/*.crt >/dev/null 2>&1; then \
      update-ca-certificates && echo "trusting operator-supplied CA certificates"; \
    fi

# Dependencies first so a source-only change does not re-download the module
# graph on every build.
COPY go.mod go.sum ./
# Credentials for a private module proxy arrive as a mounted secret, never as
# a build argument: an ARG is readable forever in `docker history`. /root/.netrc
# is where the Go toolchain looks, and the mount exists only for this RUN.
RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

# CGO_ENABLED=0 produces a static binary for distroless. This is only possible
# because the SQLite driver is modernc.org/sqlite (pure Go); the cgo driver
# would force a glibc base image for what is a development-only convenience.
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Version=${VERSION} \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Commit=${COMMIT} \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Date=${BUILD_DATE}" \
      -o /out/coordinator ./cmd/coordinator

# --- helm ---------------------------------------------------------------------
#
# A separate stage so the download is cached independently of the Go build, and
# so nothing but the verified binary reaches the runtime image.
#
# The checksum is PINNED here rather than read from the .sha256sum file beside
# the tarball: fetching both from the same host means whoever controls the host
# controls both, and the verification proves nothing. TARGETARCH is supplied by
# buildkit, so one Dockerfile builds a correct image for either architecture.
FROM ${GO_IMAGE} AS helm
ARG HELM_VERSION
ARG HELM_SHA256_amd64
ARG HELM_SHA256_arm64
ARG TARGETARCH
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY}
COPY deploy/certs/ /usr/local/share/ca-certificates/extra/
RUN if ls /usr/local/share/ca-certificates/extra/*.crt >/dev/null 2>&1; then \
      update-ca-certificates; \
    fi
RUN set -eu; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) want="$HELM_SHA256_amd64" ;; \
      arm64) want="$HELM_SHA256_arm64" ;; \
      *) echo "no pinned helm checksum for architecture $arch" >&2; exit 1 ;; \
    esac; \
    tarball="helm-v${HELM_VERSION}-linux-${arch}.tar.gz"; \
    curl -fsSL -o "/tmp/$tarball" "https://get.helm.sh/$tarball"; \
    echo "$want  /tmp/$tarball" | sha256sum -c -; \
    tar -xzf "/tmp/$tarball" -C /tmp; \
    install -m 0755 "/tmp/linux-${arch}/helm" /out-helm; \
    /out-helm version --short

# Overridable for an internal registry or pull-through proxy. Pinned by digest
# would be stronger still; :nonroot is what upstream documents and what the
# published deployment manifests use.
FROM ${RUNTIME_IMAGE}
COPY --from=build /out/coordinator /coordinator
# helm is a static Go binary, which is why it runs in a distroless STATIC
# image at all. It goes on PATH under its own name because that is what
# render.Helm looks for when no binary is configured.
COPY --from=helm /out-helm /usr/local/bin/helm
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/coordinator"]
