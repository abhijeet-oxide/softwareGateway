# syntax=docker/dockerfile:1
#
# transferctl image, for running the CLI in CI (chiefly `config validate`).
#
# The CLI is a pure Coordinator API client and needs no cluster access, no
# registry credentials and no database - so this image is safe to run anywhere.

# Pinned, and overridable so an internal registry or pull-through proxy can be
# used: docker compose build --build-arg GO_IMAGE=registry.corp/golang:1.25.14
# Base images: declared here, above every FROM, because an ARG used in a
# FROM must be in the global scope - one declared inside a stage is
# invisible to the next FROM and fails with "base name should not be blank".
# All are overridable for an internal registry or pull-through proxy.
ARG GO_IMAGE=golang:1.25.14
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

FROM ${GO_IMAGE} AS build
WORKDIR /src

# See build/Dockerfile.web for why this exists: a TLS-intercepting corporate
# proxy makes `go mod download` fail with x509: certificate signed by unknown
# authority, and the only correct fix is to trust the proxy's CA.
COPY deploy/certs/ /usr/local/share/ca-certificates/extra/
RUN if ls /usr/local/share/ca-certificates/extra/*.crt >/dev/null 2>&1; then \
      update-ca-certificates && echo "trusting operator-supplied CA certificates"; \
    fi

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Version=${VERSION} \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Commit=${COMMIT} \
        -X github.com/abhijeet-oxide/softwareGateway/internal/platform/version.Date=${BUILD_DATE}" \
      -o /out/transferctl ./cmd/transferctl

# Overridable for an internal registry or pull-through proxy. Pinned by digest
# would be stronger still; :nonroot is what upstream documents and what the
# published deployment manifests use.
FROM ${RUNTIME_IMAGE}
COPY --from=build /out/transferctl /transferctl
USER nonroot:nonroot
ENTRYPOINT ["/transferctl"]
