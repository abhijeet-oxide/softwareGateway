# Build output
/bin/
/dist/
# Compiled helpers, which have been committed by accident before. `fakeregistry`
# is built from dev/fakeregistry; `smoketmp` was a smoke-test binary.
/fakeregistry
/smoketmp
# Scratch main packages. A one-off fixup script belongs in a shell history, not
# in a repository where it looks like something that is maintained.
/tmp*/

# Node dependencies - the web interface vendors its own under web/
node_modules/

# Task's up-to-date checksums
/.task/

# Local development state - SQLite database and journals
/dev/*.db
/dev/*.db-shm
/dev/*.db-wal

# Test artifacts
*.out
*.test
/coverage.*

# Editors
.idea/
.vscode/
*.swp
.DS_Store
dev/products/
dev/secrets/

# Local stack secrets. .env.example is the committed template.
deploy/.env
.env

# stray local build artifacts
/coordinator
/worker
/transferctl

# npm credentials for the web build. npmrc.example is the committed template.
deploy/npm/npmrc
deploy/npm/.npmrc
deploy/go/netrc
podman-build-secret*

# The mock directory's own certificate authority. Generated by
# deploy/mock-entra/mkcerts.sh; a private key belongs in no repository.
deploy/mock-entra/certs/
