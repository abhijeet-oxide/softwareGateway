# cd.yml, for a repository that cannot reach the public internet.
#
# NOT RUN FROM THIS REPOSITORY. GitHub reads `.yml` and `.yaml` under
# .github/workflows/ and nothing else, so the `.disabled` suffix keeps this file
# inert here. In the enterprise repository it is copied over `cd.yml` and the
# suffix dropped. See .github/workflows/README.md.
#
# ------------------------------------------------------------------ deviations
#
# 1. NO HOSTED-RUNNER FALLBACK. `runs-on` is RUNNER_LABEL with no
#    `|| 'ubuntu-latest'`. A hosted runner's address is not on the repository
#    owner's IP allow list and fails in `actions/checkout` with a 403 before it
#    reads a line of code. Unset, RUNNER_LABEL fails the run at startup with
#    "invalid value for 'runs-on'", which at least names the setting.
#
# 2. THE TOOLCHAIN COMES FROM A MIRROR. `.github/actions/toolchain` fetches Task,
#    Helm, kustomize, kubeconform and golangci-lint from github.com and
#    get.helm.sh. TOOL_MIRROR points that at an internal host; unset, it is
#    upstream exactly as in the public file.
#
# 3. NPM COMES FROM THE CONFIGURED REGISTRY. pnpm itself is installed with npm
#    (see .github/actions/web-toolchain), so NPM_REGISTRY decides where both the
#    package manager and the packages come from - one host to allow, not two.
#
# ------------------------------------------------------------------- variables
#
#   RUNNER_LABEL   required. The in-network self-hosted runner.
#   TOOL_MIRROR    optional. Base URL for released binaries, flat by file name.
#   NPM_REGISTRY   optional. The npm registry or pull-through mirror.
#   REGISTRY_*     as in the public file: host, repository, and the two secrets.
name: CD

on:
  push:
    branches: [main]
    paths-ignore:
      # Pointer changes are deployment-only and must not publish a new release.
      - 'deploy/flux/instances/**'
      - 'deploy/flux/software/patch/**'
      - 'docs/**'
      - '**/*.md'
  workflow_dispatch:

# Queue releases per branch so version calculation and publishing cannot race.
concurrency:
  group: cd-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: write       # the version tag, and the one-line pointer commit
  pull-requests: write  # main is rule-protected: the pointer commit goes through a PR

env:
  GO_VERSION: "1.26"

  # WHERE GO MODULES COME FROM, for the jobs themselves - the Dockerfiles have
  # taken these as build arguments from the start and the workflows never set
  # them, so every `go` command on a runner went to proxy.golang.org whatever an
  # internal mirror was configured for.
  #
  # GOSUMDB travels with GOPROXY because it is the next thing to fail: with a
  # complete go.sum nothing is looked up, but `go run <module>@latest` - which
  # is how govulncheck is installed - resolves a module that go.sum has never
  # seen and verifies it against the checksum database. A mirror that proxies
  # modules and not `sum.golang.org` fails there. Set GOSUMDB to `off` if the
  # mirror is trusted and does not serve it.
  #
  # The defaults are Go's own, so an unset variable is the behaviour Go would
  # have had anyway. Set the VARIABLES rather than editing these lines: a
  # company's mirror does not belong in this repository (CLAUDE.md).
  GOPROXY: ${{ vars.GOPROXY || 'https://proxy.golang.org,direct' }}
  GOSUMDB: ${{ vars.GOSUMDB || 'sum.golang.org' }}
  GODEBUG: http2client=0
  # THE PROXY, FOR THE RUNNER'S OWN FETCHES - not only for the image builds,
  # which have had it as build arguments all along (see the `images` job). A
  # release also downloads Helm and kustomize and talks to the registry from the
  # runner itself, and none of that was going through it.
  #
  # UPPER CASE ONLY: a workflow's `env` keys are compared case-insensitively, so
  # the pair the Dockerfiles set would be one key here and GitHub would refuse
  # the file with "'http_proxy' is already defined". Go, npm, pnpm and the runner
  # read either case, and curl takes the upper for everything but plain
  # `http://`, which no URL in these workflows is.
  #
  # Unset, they are empty and every tool reads that as "no proxy" - so on a
  # runner whose image carries a proxy these variables must be SET rather than
  # left to the image: an empty value here overrides it.
  HTTP_PROXY: ${{ vars.HTTP_PROXY }}
  HTTPS_PROXY: ${{ vars.HTTPS_PROXY }}
  NO_PROXY: ${{ vars.NO_PROXY }}
  # The registry this product publishes to. Set these repository variables to
  # point the pipeline at your own Artifactory, ACR or Harbor.
  REGISTRY_HOST: ${{ vars.REGISTRY_HOST }}
  REGISTRY_URL: https://${{ vars.REGISTRY_HOST }}
  REGISTRY_REPOSITORY: ${{ vars.REGISTRY_REPOSITORY }}

jobs:
  # ---------------------------------------------------------------- 1. version
  version:
    name: Decide the version
    # Self-hosted runners are selected with the RUNNER_LABEL repository variable.
    runs-on: ${{ vars.RUNNER_LABEL }}
    timeout-minutes: 10
    outputs:
      chart_version: ${{ steps.v.outputs.chart_version }}
      image_version: ${{ steps.v.outputs.image_version }}
      images_changed: ${{ steps.v.outputs.images_changed }}
      should_release: ${{ steps.v.outputs.should_release }}
      configured: ${{ steps.registry.outputs.configured }}
      tag: ${{ steps.v.outputs.tag }}
      instance: ${{ steps.env.outputs.name }}
    steps:
      - uses: actions/checkout@v7
        with:
          # Version calculation requires complete tag and commit history.
          fetch-depth: 0

      - id: env
        env:
          REF: ${{ github.ref_name }}
        run: |
          case "$REF" in
            main) echo "name=lab" >> "$GITHUB_OUTPUT" ;;
            *)    echo "::error::CD runs on main only"; exit 1 ;;
          esac

      # A FORK, OR A REPOSITORY NOBODY HAS POINTED AT A REGISTRY YET, has no
      # REGISTRY_* variables. Publishing then fails inside docker/login-action
      # with "Username and password required", which reads like a broken
      # pipeline rather than an unconfigured one. Detect it here and skip the
      # publishing jobs with an explanation instead.
      - id: registry
        env:
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_TOKEN: ${{ secrets.REGISTRY_TOKEN }}
        run: |
          missing=()
          [ -n "${REGISTRY_HOST:-}" ]       || missing+=("vars.REGISTRY_HOST")
          [ -n "${REGISTRY_REPOSITORY:-}" ] || missing+=("vars.REGISTRY_REPOSITORY")
          [ -n "${REGISTRY_USERNAME:-}" ]   || missing+=("secrets.REGISTRY_USERNAME")
          [ -n "${REGISTRY_TOKEN:-}" ]      || missing+=("secrets.REGISTRY_TOKEN")
          if [ ${#missing[@]} -eq 0 ]; then
            echo "configured=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "configured=false" >> "$GITHUB_OUTPUT"
          {
            echo "### Publishing skipped - no registry configured"
            echo
            echo "CD computed the version but published nothing. Set these in"
            echo "**Settings -> Secrets and variables -> Actions** and re-run:"
            echo
            for m in "${missing[@]}"; do echo "- \`${m}\`"; done
          } >> "$GITHUB_STEP_SUMMARY"

      - id: v
        env:
          CHANNEL: ${{ github.ref_name }}
        run: bash .github/scripts/version.sh

      # Reserve the version now, before anything is built or pushed. Image
      # tags are immutable, so any later failure (build, chart, promote, a
      # cancelled matrix sibling) must never leave this version un-tagged -
      # otherwise the next run recomputes the exact same version from git
      # tags alone and collides with the image this run already pushed.
      #
      # Nothing is published when the registry is unconfigured, so nothing is
      # reserved either: the version stays available for the run that does.
      - name: Reserve the release tag
        if: steps.v.outputs.should_release == 'true' && steps.registry.outputs.configured == 'true'
        env:
          TAG: ${{ steps.v.outputs.tag }}
          CHART_VERSION: ${{ steps.v.outputs.chart_version }}
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git tag -a "$TAG" -m "$CHART_VERSION"
          git push origin "$TAG"

  # ----------------------------------------------------------------- 2. images
  #
  # Configuration-only releases reuse the existing application images.
  images:
    name: ${{ matrix.component }} image
    needs: version
    if: >-
      needs.version.outputs.should_release == 'true'
      && needs.version.outputs.configured == 'true'
      && needs.version.outputs.images_changed == 'true'
    # Self-hosted runners are selected with the RUNNER_LABEL repository variable.
    runs-on: ${{ vars.RUNNER_LABEL }}
    timeout-minutes: 45
    strategy:
      fail-fast: true
      matrix:
        include:
          - component: coordinator
            dockerfile: deploy/build/Dockerfile.coordinator
          - component: worker
            dockerfile: deploy/build/Dockerfile.worker
          - component: web
            dockerfile: deploy/build/Dockerfile.web
    steps:
      - uses: actions/checkout@v7

      # The default docker-container driver, deliberately. The `docker` driver
      # builds through the runner's own daemon, whose image store cannot export
      # a cache: the registry cache below failed the release with "cache export
      # is not supported by the docker driver". The alternative fix - the
      # daemon's containerd image store - is a change to every runner host,
      # including hosts this repository does not own, to buy a local image the
      # job never uses. Nothing here reads the image back out of the daemon;
      # it is pushed, and the next step talks to the registry.
      - uses: docker/setup-buildx-action@37fe631027851001ddb9b187196cc803df7f5f0e # v4

      - uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4
        with:
          registry: ${{ env.REGISTRY_HOST }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_TOKEN }}

      - name: Prepare npm registry credentials
        if: matrix.component == 'web'
        env:
          REGISTRY_TOKEN: ${{ secrets.REGISTRY_TOKEN }}
          NPM_REGISTRY: ${{ vars.NPM_REGISTRY || 'https://registry.npmjs.org/' }}
        run: |
          umask 077
          cat > "$RUNNER_TEMP/npmrc" <<EOF
          registry=${NPM_REGISTRY}
          ${NPM_REGISTRY#https:}:_authToken=${REGISTRY_TOKEN}
          always-auth=true
          EOF

      - name: Prepare Go module proxy credentials
        if: matrix.component != 'web'
        env:
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_TOKEN: ${{ secrets.REGISTRY_TOKEN }}
        run: |
          umask 077
          cat > "$RUNNER_TEMP/netrc" <<EOF
          machine ${REGISTRY_HOST}
            login ${REGISTRY_USERNAME}
            password ${REGISTRY_TOKEN}
          EOF

      # Image tags are immutable; fail on collisions instead of overwriting.
      - name: The tag must not already exist
        env:
          COMPONENT: ${{ matrix.component }}
          IMAGE_VERSION: ${{ needs.version.outputs.image_version }}
        run: |
          registry="${REGISTRY_URL#https://}"
          registry="${registry#http://}"
          ref="${registry}/${REGISTRY_REPOSITORY}/software-gateway-${COMPONENT}:${IMAGE_VERSION}"
          if docker buildx imagetools inspect "$ref" >/dev/null 2>&1; then
            echo "::error::$ref already exists. An image tag is written once."
            echo "::error::This means a release tag was deleted and recreated, or two runs raced."
            exit 1
          fi
          echo "$ref is free"

      - uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7
        with:
          context: .
          file: ${{ matrix.dockerfile }}
          push: true
          platforms: linux/amd64
          tags: ${{ env.REGISTRY_HOST }}/${{ env.REGISTRY_REPOSITORY }}/software-gateway-${{ matrix.component }}:${{ needs.version.outputs.image_version }}
          # A layer cache in the registry, keyed per component. The Go and pnpm
          # dependency layers are the expensive ones and they change rarely, so
          # a release that touches one package rebuilds one layer.
          cache-from: type=registry,ref=${{ env.REGISTRY_HOST }}/${{ env.REGISTRY_REPOSITORY }}/software-gateway-${{ matrix.component }}:buildcache
          cache-to: type=registry,ref=${{ env.REGISTRY_HOST }}/${{ env.REGISTRY_REPOSITORY }}/software-gateway-${{ matrix.component }}:buildcache,mode=max
          # GOPROXY and GOSUMDB come from this workflow's env, so their defaults
          # live in one place. GOSUMDB was never passed at all, though every
          # Dockerfile here declares the ARG: an image built against a mirror that
          # does not serve the checksum database had no way to be told so.
          build-args: |
            VERSION=${{ needs.version.outputs.image_version }}
            COMMIT=${{ github.sha }}
            BUILD_DATE=${{ github.event.repository.updated_at }}
            HTTP_PROXY=${{ vars.HTTP_PROXY }}
            HTTPS_PROXY=${{ vars.HTTPS_PROXY }}
            NO_PROXY=${{ vars.NO_PROXY }}
            GOPROXY=${{ env.GOPROXY }}
            GOSUMDB=${{ env.GOSUMDB }}
            NPM_REGISTRY=${{ vars.NPM_REGISTRY || 'https://registry.npmjs.org/' }}
          # Mount credentials into builds; build arguments remain visible in image history.
          secret-files: ${{ matrix.component == 'web' && format('npmrc={0}/npmrc', runner.temp) || format('netrc={0}/netrc', runner.temp) }}
          provenance: false

  # ------------------------------------------------------------------ 3. chart
  chart:
    name: Package and publish the chart
    needs: [version, images]
    # Run even when the images job is skipped for a configuration-only release.
    if: >-
      always()
      && needs.version.result == 'success'
      && needs.version.outputs.should_release == 'true'
      && needs.version.outputs.configured == 'true'
      && (needs.images.result == 'success' || needs.images.result == 'skipped')
    # Self-hosted runners are selected with the RUNNER_LABEL repository variable.
    runs-on: ${{ vars.RUNNER_LABEL }}
    timeout-minutes: 20
    outputs:
      chart_version: ${{ needs.version.outputs.chart_version }}
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/toolchain
        with:
          go-version: ${{ env.GO_VERSION }}
          helm: 'true'
          mirror: ${{ vars.TOOL_MIRROR }}

      # Helm packages a directory, so stage the shared config into the chart.
      - name: Stage config/ into the chart
        run: go run ./deploy/chartstage/cmd/chartstage

      - name: Lint
        run: |
          helm lint deploy/charts/software-gateway \
            --set identity.masterkey.value=0123456789abcdef0123456789abcdef \
            --set identity.rootPassword.value=lint

      # Render every instance, both layers, before publishing the chart. A
      # values file that trips a validation rule must fail here rather than as a
      # reconciliation error in a cluster.
      - name: Render every instance
        run: |
          set -euo pipefail
          for instance in $(go run ./deploy/chartstage/cmd/chartstage -instances | awk '{print $1}'); do
            go run ./deploy/chartstage/cmd/chartstage -values "$instance" > "$RUNNER_TEMP/$instance-values.yaml"
            for layer in database application; do
              db=false; app=false
              [ "$layer" = database ] && db=true || app=true
              helm template swgw deploy/charts/software-gateway \
                --values "$RUNNER_TEMP/$instance-values.yaml" \
                --set "layers.database=$db" --set "layers.application=$app" \
                > "$RUNNER_TEMP/$instance-$layer.yaml"
              echo "$instance/$layer: $(grep -c '^kind:' "$RUNNER_TEMP/$instance-$layer.yaml") objects"
            done
          done

      - name: Package
        env:
          CHART_VERSION: ${{ needs.version.outputs.chart_version }}
          IMAGE_VERSION: ${{ needs.version.outputs.image_version }}
        run: |
          helm package deploy/charts/software-gateway \
            --version "$CHART_VERSION" \
            --app-version "$IMAGE_VERSION" \
            --destination "$RUNNER_TEMP/chart"
          ls -l "$RUNNER_TEMP/chart"

      - name: Publish
        env:
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_TOKEN: ${{ secrets.REGISTRY_TOKEN }}
          CHART_VERSION: ${{ needs.version.outputs.chart_version }}
        run: |
          registry="${REGISTRY_URL#https://}"
          registry="${registry#http://}"
          # On stdin, so the token never appears in a process listing.
          helm registry login "$registry" --username "$REGISTRY_USERNAME" --password-stdin <<<"$REGISTRY_TOKEN"
          helm push "$RUNNER_TEMP/chart/software-gateway-${CHART_VERSION}.tgz" \
            "oci://${registry}/${REGISTRY_REPOSITORY}"

  # ---------------------------------------------------------------- 4. promote
  #
  # Deployment is a Git pointer update; Flux performs the cluster reconciliation
  # once a person merges the PR this job opens.
  promote:
    name: Point ${{ needs.version.outputs.instance }} at it
    needs: [version, chart]
    if: >-
      always()
      && needs.version.result == 'success'
      && needs.version.outputs.should_release == 'true'
      && needs.chart.result == 'success'
    # Self-hosted runners are selected with the RUNNER_LABEL repository variable.
    runs-on: ${{ vars.RUNNER_LABEL }}
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - uses: actions/setup-go@v7
        with:
          go-version: ${{ env.GO_VERSION }}
          cache: true

      # main is rule-protected ("Changes must be made through a pull request"),
      # so the pointer update goes out on a side branch and a person merges it.
      # This job neither merges the PR nor deletes the branch afterwards: both
      # are forbidden by policy here, and the token has no permission for
      # either.
      - name: Move the pointer
        id: pr
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          INSTANCE: ${{ needs.version.outputs.instance }}
          CHART_VERSION: ${{ needs.version.outputs.chart_version }}
          IMAGE_VERSION: ${{ needs.version.outputs.image_version }}
          IMAGES_CHANGED: ${{ needs.version.outputs.images_changed }}
          BASE_REF: ${{ github.ref_name }}
        run: |
          set -euo pipefail

          # The same command a person runs to roll back: it creates the patch
          # directory for this version if it does not exist and repoints the
          # instance at it.
          previous_version="$(go run ./deploy/chartstage/cmd/chartstage -instances \
            | awk -v i="$INSTANCE" '$1 == i {print $2}')"
          go run ./deploy/chartstage/cmd/chartstage -instance "$INSTANCE" -set-version "$CHART_VERSION"
          file="deploy/flux/instances/${INSTANCE}/release/kustomization.yaml"

          # NOTHING TO SAY. chartstage is idempotent, so a re-run against a
          # version the instance already points at leaves the tree clean. An
          # empty commit and an empty PR are noise a reviewer has to read.
          if git diff --quiet -- deploy/flux; then
            echo "opened=false" >> "$GITHUB_OUTPUT"
            echo "${INSTANCE} already points at ${CHART_VERSION}; no PR opened"
            exit 0
          fi

          if [ "$IMAGES_CHANGED" = "true" ]; then
            image_note="New images were built and pushed for this release (tag \`${IMAGE_VERSION}\`)."
          else
            image_note="No code changed, so this release reuses the existing images (tag \`${IMAGE_VERSION}\`) - only configuration moved."
          fi

          body=$(cat <<EOF
          ## What this PR does
          Points **${INSTANCE}** at release **${CHART_VERSION}** (previously \`${previous_version}\`).

          This repoints \`${file}\` at \`deploy/flux/software/patch/${CHART_VERSION}\`. [Flux](https://fluxcd.io/) picks up the change once this PR is merged and applies it to the cluster - no manual deployment step is needed.

          | | |
          |---|---|
          | Instance | \`${INSTANCE}\` |
          | Chart version | \`${CHART_VERSION}\` (was \`${previous_version}\`) |
          | Image tag | \`${IMAGE_VERSION}\` |
          | Images rebuilt? | ${IMAGES_CHANGED} |
          | Source commit | ${GITHUB_SHA} |
          | Triggered by | [this CD run](${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}) |

          ${image_note}

          Opened automatically by the CD pipeline; no cluster credential was used to produce it. **A person merges this** - the pipeline does not, and does not delete the branch.
          EOF
          )

          branch="deploy/${INSTANCE}-${CHART_VERSION}"
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git checkout -b "$branch"
          git add deploy/flux
          git commit \
            -m "deploy(${INSTANCE}): ${CHART_VERSION}" \
            -m "Points ${INSTANCE} at release ${CHART_VERSION} (was ${previous_version}). ${image_note}"
          git push origin "$branch"

          pr_url=$(gh pr create \
            --base "$BASE_REF" \
            --head "$branch" \
            --title "deploy(${INSTANCE}): ${previous_version} -> ${CHART_VERSION}" \
            --body "$body")

          echo "opened=true" >> "$GITHUB_OUTPUT"
          echo "url=$pr_url" >> "$GITHUB_OUTPUT"

      - name: Summary
        env:
          OPENED: ${{ steps.pr.outputs.opened }}
          PR_URL: ${{ steps.pr.outputs.url }}
          INSTANCE: ${{ needs.version.outputs.instance }}
          CHART_VERSION: ${{ needs.version.outputs.chart_version }}
          IMAGE_VERSION: ${{ needs.version.outputs.image_version }}
        run: |
          {
            echo "### Released ${CHART_VERSION}"
            echo
            echo "- chart \`${CHART_VERSION}\`"
            echo "- images \`${IMAGE_VERSION}\`"
            if [ "$OPENED" = "true" ]; then
              echo "- pointer PR for **${INSTANCE}**: ${PR_URL}"
              echo
              echo "Merge that PR to deploy. Flux applies it within a minute."
            else
              echo
              echo "${INSTANCE} already pointed at this version; no PR was opened."
            fi
            echo
            echo "Nothing here touched a cluster."
          } >> "$GITHUB_STEP_SUMMARY"
