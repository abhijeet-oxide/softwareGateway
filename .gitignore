# Build output
/bin/
/dist/

# `task chart:template` renders an environment's values to compare against the
# chart. It is scratch, and it is written at the repository root because that is
# where helm is invoked from.
/.task-values.yaml

# Compiled helpers, which have been committed by accident before. `fakeregistry`
# is built from test/cmd/fakeregistry; `smoketmp` was a smoke-test binary.
/fakeregistry
/smoketmp
# Scratch main packages. A one-off fixup script belongs in a shell history, not
# in a repository where it looks like something that is maintained.
/tmp*/

# Node dependencies - the web interface vendors its own under web/
node_modules/

# Task's up-to-date checksums
/.task/

# Test artifacts
*.out
*.test
/coverage.*

# Editors
.idea/
.vscode/
*.swp
.DS_Store
# dev/ holds LOCAL RUNTIME STATE and nothing else: the SQLite database, its
# journals, a stray log. Everything that was configuration moved to config/ and
# everything that was tooling moved to test/, so the whole directory is
# disposable and none of it is committed. Deleting it is a reset.
dev/*
!dev/README.md

# Local stack secrets. .env.example is the committed template.
deploy/.env
.env

# stray local build artifacts
/coordinator
/worker
/transferctl

# npm credentials for the web build. npmrc.example is the committed template.
deploy/npm/npmrc
deploy/npm/.npmrc
deploy/go/netrc
podman-build-secret*

# The mock directory's own certificate authority. Generated by
# test/mockEntra/mkcerts.sh; a private key belongs in no repository.
test/mockEntra/certs/

# Registry credentials for local development. The same layout a projected
# Kubernetes Secret produces, filled in by hand. config/secrets/manifests/ is
# committed and holds references; this holds values and never is.
config/secrets/local/*
!config/secrets/local/.gitkeep

# Local product config files for testing
config/products/*-dev.yaml
